run = "sh replit-setup.sh && php artisan serve --host=0.0.0.0 --port=8000"
entrypoint = "public/index.php"

[nix]
channel = "stable-23_11"

[deployment]
run = ["sh", "-c", "composer install --no-dev && npm install && npm run build && php artisan migrate --force && php artisan serve --host=0.0.0.0 --port=8000"]

[ports]
8000 = { externalPort = 80 }

[hints]
# This will show a hint in the Replit console
suggestedFiles = [".env", "composer.json", "package.json"]
