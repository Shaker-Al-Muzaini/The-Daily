run = "npm run dev & php artisan serve"
modules = ["nodejs-20", "php-8.2", "bash", "web"]

[nix]
channel = "stable-25_05"
packages = ["nodejs", "php", "composer"]

[[ports]]
localPort = 3000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8000

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "php artisan serve --host=0.0.0.0 --port=5000"
waitForPort = 5000

[agent]
expertMode = true

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "-c", "php artisan serve --host=0.0.0.0 --port=5000"]
build = ["bash", "-c", "composer install --no-interaction --ignore-platform-reqs && npm install --legacy-peer-deps && npm run build && php artisan key:generate --force && php artisan migrate --force"]
