run = "npm run dev & php artisan serve"
modules = ["nodejs-20", "php-8.2", "bash", "web"]

[nix]
channel = "stable-25_05"
packages = ["nodejs", "php", "composer"]

[[ports]]
socket = 3000
internalPort = 3000
declare = "React"

[[ports]]
socket = 8000
internalPort = 8000
declare = "Laravel"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "php artisan serve --host=0.0.0.0 --port=8000"
waitForPort = 8000

[workflows.workflow.metadata]
outputType = "console"
